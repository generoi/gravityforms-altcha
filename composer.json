{
    "name": "generoi/gravityforms-altcha",
    "type": "wordpress-plugin",
    "license": "MIT",
    "description": "Invisible ALTCHA spam protection for Gravity Forms",
    "homepage": "https://github.com/generoi/gravityforms-altcha",
    "authors": [
        {
            "name": "Genero",
            "email": "info@genero.fi"
        }
    ],
    "require": {
        "php": ">=8.2",
        "altcha-org/altcha": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "phpunit/phpunit": "^9.0",
        "brain/monkey": "^2.6",
        "wp-phpunit/wp-phpunit": "^7.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Genero\\GravityFormsAltcha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Genero\\GravityFormsAltcha\\Tests\\": "test/unit/",
            "Genero\\GravityFormsAltcha\\Tests\\Mocked\\": "test/mocked/",
            "Genero\\GravityFormsAltcha\\Tests\\Integration\\": "test/integration/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test": "phpunit",
        "test:integration": "phpunit -c phpunit.integration.xml.dist"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
